# Copy to .env. Everything here is optional: with none of it set, the gateway
# still runs and the zero-key demo still works, because relay/zero-key-demo is
# served by a free local model.

# --- provider credentials ---------------------------------------------------
#
# The variable name is derived from the endpoint's credential_ref in
# config/catalog.yaml by provider.EnvResolver.EnvVarFor: upper-cased, with
# -./@ replaced by underscores, behind the prefix RELAY_CRED_.
#
#   credential_ref: anthropic-primary  ->  RELAY_CRED_ANTHROPIC_PRIMARY
#
# There is one rule and it is in the code, so this file cannot drift from it.

RELAY_CRED_OPENAI_PRIMARY=
RELAY_CRED_ANTHROPIC_PRIMARY=

# google/gemini-flash@us-central is in the catalog but THIS BUILD HAS NO GOOGLE
# ADAPTER. Setting a key changes nothing: routing does not know which providers
# are compiled in, so the endpoint is ranked normally and then fails at
# execution. The gateway warns about it at startup and lists it under
# unreachable_endpoints on /readyz. Left here because this is where someone
# looks before they look at either of those.
#RELAY_CRED_GOOGLE_PRIMARY=

# --- deployment addresses ---------------------------------------------------
#
# The only catalog field read from the environment. Prices, quality scores and
# attestations deliberately are not; see internal/catalog/expand.go.
RELAY_OLLAMA_URL=http://localhost:11434

# --- console ----------------------------------------------------------------
#
# Read by the Next.js app in web/, server-side only. RELAY_ADMIN_URL must never
# be given a NEXT_PUBLIC_ prefix: the admin listener has no authentication until
# Phase 7 and returns every tenant's spend when unscoped.
RELAY_URL=http://localhost:8080
RELAY_ADMIN_URL=http://localhost:9090

# The tenant the console attributes its own traffic to. Demo-only; rotate before
# this is pointed at anything real.
RELAY_DEMO_TENANT_KEY=sk-relay-demo-optimize-0f1e2d3c4b5a
