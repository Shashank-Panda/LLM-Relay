# Server-side only. Nothing here may be given a NEXT_PUBLIC_ prefix.
#
# RELAY_ADMIN_URL in particular: the admin listener has no authentication until
# Phase 7 and returns every tenant's spend when unscoped, so the browser must
# not be able to reach it. These route handlers are the only thing that may.
RELAY_URL=http://localhost:8080
RELAY_ADMIN_URL=http://localhost:9090

# The tenant the console attributes its own traffic to. It must be in optimize
# mode for the Explain tab to demonstrate substitution — see config/tenants.yaml.
RELAY_DEMO_TENANT_KEY=sk-relay-demo-optimize-0f1e2d3c4b5a
